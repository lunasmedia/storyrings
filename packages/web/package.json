{
  "name": "@lunasmedia/storyrings-web",
  "version": "0.1.1",
  "description": "Instagram-style stories for any website: framework-free, accessible, ~12 KB gzipped",
  "license": "MIT",
  "keywords": [
    "stories",
    "web",
    "widget"
  ],
  "homepage": "https://github.com/lunasmedia/storyrings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunasmedia/storyrings.git",
    "directory": "packages/web"
  },
  "bugs": "https://github.com/lunasmedia/storyrings/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "require": "./dist/preview.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/size.mjs",
    "dev": "tsup --watch src --watch ../core/src --watch ../contracts/src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "tsup && node scripts/size.mjs"
  },
  "devDependencies": {
    "@stories/contracts": "workspace:*",
    "@stories/core": "workspace:0.1.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
