{
  "suite": "tags",
  "description": "User tags (normalised before sending) and story group tag filters (every condition must pass; include = any of its tags, exclude = none of them).",
  "cases": [
    {
      "name": "tags are lowercased, trimmed, de-duplicated and sorted",
      "input": {
        "op": "normalize",
        "tags": [" London", "premium", "london", "City:Leeds"]
      },
      "expect": {
        "tags": ["city:leeds", "london", "premium"]
      }
    },
    {
      "name": "invalid tags are dropped",
      "input": {
        "op": "normalize",
        "tags": ["ok", "a b", "x@y.com", "-lead", "", "UPPER_ok"]
      },
      "expect": {
        "tags": ["ok", "upper_ok"]
      }
    },
    {
      "name": "a comma-separated string works too",
      "input": {
        "op": "normalize",
        "tags": "london,,PREMIUM"
      },
      "expect": {
        "tags": ["london", "premium"]
      }
    },
    {
      "name": "at most 50 tags are kept",
      "input": {
        "op": "normalize",
        "tags": [
          "t00",
          "t01",
          "t02",
          "t03",
          "t04",
          "t05",
          "t06",
          "t07",
          "t08",
          "t09",
          "t10",
          "t11",
          "t12",
          "t13",
          "t14",
          "t15",
          "t16",
          "t17",
          "t18",
          "t19",
          "t20",
          "t21",
          "t22",
          "t23",
          "t24",
          "t25",
          "t26",
          "t27",
          "t28",
          "t29",
          "t30",
          "t31",
          "t32",
          "t33",
          "t34",
          "t35",
          "t36",
          "t37",
          "t38",
          "t39",
          "t40",
          "t41",
          "t42",
          "t43",
          "t44",
          "t45",
          "t46",
          "t47",
          "t48",
          "t49",
          "t50",
          "t51",
          "t52",
          "t53",
          "t54",
          "t55",
          "t56",
          "t57",
          "t58",
          "t59"
        ]
      },
      "expect": {
        "tags": [
          "t00",
          "t01",
          "t02",
          "t03",
          "t04",
          "t05",
          "t06",
          "t07",
          "t08",
          "t09",
          "t10",
          "t11",
          "t12",
          "t13",
          "t14",
          "t15",
          "t16",
          "t17",
          "t18",
          "t19",
          "t20",
          "t21",
          "t22",
          "t23",
          "t24",
          "t25",
          "t26",
          "t27",
          "t28",
          "t29",
          "t30",
          "t31",
          "t32",
          "t33",
          "t34",
          "t35",
          "t36",
          "t37",
          "t38",
          "t39",
          "t40",
          "t41",
          "t42",
          "t43",
          "t44",
          "t45",
          "t46",
          "t47",
          "t48",
          "t49"
        ]
      }
    },
    {
      "name": "no filter shows to everyone",
      "input": {
        "op": "filter",
        "conditions": [],
        "tags": []
      },
      "expect": {
        "matches": true
      }
    },
    {
      "name": "include passes with any of its tags",
      "input": {
        "op": "filter",
        "conditions": [
          {
            "mode": "include",
            "tags": ["london", "leeds"]
          }
        ],
        "tags": ["leeds"]
      },
      "expect": {
        "matches": true
      }
    },
    {
      "name": "include fails without them",
      "input": {
        "op": "filter",
        "conditions": [
          {
            "mode": "include",
            "tags": ["london", "leeds"]
          }
        ],
        "tags": ["york"]
      },
      "expect": {
        "matches": false
      }
    },
    {
      "name": "exclude fails with any of its tags",
      "input": {
        "op": "filter",
        "conditions": [
          {
            "mode": "include",
            "tags": ["london"]
          },
          {
            "mode": "exclude",
            "tags": ["churned"]
          }
        ],
        "tags": ["london", "churned"]
      },
      "expect": {
        "matches": false
      }
    },
    {
      "name": "every condition must pass",
      "input": {
        "op": "filter",
        "conditions": [
          {
            "mode": "include",
            "tags": ["london"]
          },
          {
            "mode": "include",
            "tags": ["premium"]
          }
        ],
        "tags": ["london"]
      },
      "expect": {
        "matches": false
      }
    }
  ]
}
