{
  "name": "@lunasmedia/storyrings-react",
  "version": "0.1.1",
  "description": "React component for Stories: <StoriesBar token=\"\u2026\" />",
  "license": "MIT",
  "keywords": [
    "stories",
    "react"
  ],
  "homepage": "https://github.com/lunasmedia/storyrings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunasmedia/storyrings.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/lunasmedia/storyrings/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "tsup"
  },
  "dependencies": {
    "@lunasmedia/storyrings-web": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
